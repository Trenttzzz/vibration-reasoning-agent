# value "sumopod" / "openrouter"
LLM_PROVIDER=sumopod

SUMOPOD_API_KEY=your_sumopod_api_key
SUMOPOD_MODEL=glm-5.1
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_TEMPERATURE=0.2
SUMOPOD_MAX_TOKENS=5000


OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1800
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_REASONING_SUMMARY=concise